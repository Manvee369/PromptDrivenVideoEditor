# PromptDrivenVideoEditor — Environment Variables Reference
# Copy this file to .env.production and fill in the values.
# NEVER commit .env.production to Git.

# ─── LLM Planner ──────────────────────────────────────────────────────────
# Groq API key for the LLM planning stage (highlight selection, story compose).
# Get one free at https://console.groq.com
PDVE_LLM_API_KEY=

# LLM model. Groq hosts: llama-3.3-70b-versatile, openai/gpt-oss-120b, etc.
PDVE_LLM_MODEL=llama-3.3-70b-versatile

# ─── Azure AI Speech (RECOMMENDED — eliminates 9-min Whisper wait) ─────────
# Replace faster-whisper CPU transcription with Azure cloud API.
# Free tier: 5 audio hours/month (~37 x 8-min videos/month).
# Get a key: Azure Portal → Create resource → Azure AI Services → Speech
PDVE_AZURE_SPEECH_KEY=
PDVE_AZURE_SPEECH_REGION=eastus

# ─── Azure Blob Storage (RECOMMENDED for Container Apps) ───────────────────
# Stores job artifacts in Azure Blob instead of local disk.
# Required when running multiple worker replicas or using Container Apps.
# Get connection string: Azure Portal → Storage Accounts → Access keys
PDVE_STORAGE_BACKEND=local
# PDVE_STORAGE_BACKEND=azure
PDVE_AZURE_STORAGE_CONNECTION_STRING=
PDVE_AZURE_STORAGE_CONTAINER=pdve-jobs

# ─── Job Queue (Redis) ─────────────────────────────────────────────────────
# Enable the RQ worker queue so the API stays responsive during long jobs.
# For local Docker Compose: redis://redis:6379/0
# For Azure Cache for Redis: rediss://:password@name.redis.cache.windows.net:6380
PDVE_QUEUE_ENABLED=false
PDVE_REDIS_URL=redis://localhost:6379/0
PDVE_QUEUE_NAME=pipeline
PDVE_QUEUE_JOB_TIMEOUT=600

# ─── Transcription (faster-whisper fallback) ───────────────────────────────
# Only used when PDVE_AZURE_SPEECH_KEY is not set.
# Use 'small' for fast CPU testing, 'medium' or 'large-v3' on GPU.
PDVE_WHISPER_MODEL=small
PDVE_USE_WHISPERX_ALIGNMENT=false

# ─── Visual Intelligence ───────────────────────────────────────────────────
# SigLIP visual scoring — very slow on CPU, fast on GPU.
PDVE_VISUAL_SCORING_ENABLED=false

# ─── Storage & Upload Limits ───────────────────────────────────────────────
PDVE_STORAGE_BASE=storage/jobs
PDVE_MAX_UPLOAD_BYTES=2147483648
PDVE_MAX_FILES_PER_JOB=20

# ─── Security ─────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# In production: set to your actual domain.
PDVE_ALLOWED_ORIGINS_CSV=http://localhost:3000
# Production: PDVE_ALLOWED_ORIGINS_CSV=https://yourdomain.com

# Require a per-job token on /download and /thumbnail endpoints.
PDVE_DOWNLOAD_TOKEN_REQUIRED=true

# ─── Frontend ──────────────────────────────────────────────────────────────
# The public URL of the backend API, used by the Next.js frontend.
# For local dev: http://localhost:8000
# For production: https://yourdomain.com  (if proxied via nginx)
#              or https://api.yourdomain.com  (if backend on separate subdomain)
NEXT_PUBLIC_API_URL=http://localhost:8000
